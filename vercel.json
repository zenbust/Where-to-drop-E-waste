{
  "version": 2,
  "builds": [
    {
      "src": "./WTDEW-Backend/api/centers.js",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    {
      "source": "/api/centers/(.*)",
      "destination": "/api/centers.js"
    }
  ],
  "headers": [
    {
      "source": "/api/centers/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type"
        }
      ]
    }
  ]
}
